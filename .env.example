# Supabase local: `pnpm --silent db:env > .env` preenche estas chaves
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Object storage via S3 API (D-047). Local: `pnpm --silent db:env > .env` fills these from Supabase Storage.
# Production (Cloudflare R2): S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY = R2 API token, S3_BUCKET = private bucket name.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=assets

# AI services
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Payment
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Logging
LOG_LEVEL=info

# Local dev/e2e only (ignored when NODE_ENV=production): GRADER=mock injects the contracts mock grader (D-061, until F05 ships).
GRADER=
