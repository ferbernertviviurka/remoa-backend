# Supabase local: `pnpm --silent db:env > .env` preenche estas chaves
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Object storage via S3 API (D-047). Local: `pnpm --silent db:env > .env` fills these from Supabase Storage.
# Production (Cloudflare R2): S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY = R2 API token, S3_BUCKET = private bucket name.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=assets

# AI services (D-580). Real AI needs OPENROUTER_API_KEY (map generation from text/PDF, rubrics, grader via OpenRouter).
# Without it and without AI=mock, POST /v1/ai/generate-pdf|generate-board answer 503 ai_unavailable; the grader falls back to the rubric-only check.
# MISTRAL_API_KEY: OCR for scanned PDFs (pages without selectable text). Without it, text PDFs still work (pdf.js, D-581); scanned ones fail as pdf_unreadable.
# Optional model overrides: OPENROUTER_EXTRACT_MODEL, OPENROUTER_RUBRIC_MODEL, OPENROUTER_GRADER_MODEL.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Local dev/e2e only (requires NODE_ENV=development or test): AI=mock generates maps offline (deterministic draft from the PDF text, no provider call).
AI=

# Payment
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Founder (one-time, D-375). Unset = R$ 599,90.
STRIPE_PRICE_LIFETIME=
STRIPE_COUPON_FUNDADOR=
# Local dev/e2e only (requires NODE_ENV=development or test; `pnpm dev` sets it): STRIPE=mock replaces Stripe with a fake (D-100).
STRIPE=

# Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Logging
LOG_LEVEL=info

# Local dev/e2e only (requires NODE_ENV=development or test): GRADER=mock injects the contracts mock grader (D-061, until F05 ships).
GRADER=

# --- E-mail, avisos e jobs (G18 · F24/F25/F26) — para ir a produção, troque só estes valores ---
# Lidos e validados por packages/config/src/env.ts (D-732). A API não sobe se faltar algo obrigatório (a mensagem diz o quê, nunca o valor).
# Desenvolvimento (NODE_ENV=development|test, o `pnpm dev`) funciona sem nada disto: EMAIL_PROVIDER=console e padrões locais neutros.
# Produção (NODE_ENV ausente conta como produção) exige: EMAIL_PROVIDER, APP_URL (ou WEB_ORIGIN), API_ORIGIN, EMAIL_UNSUBSCRIBE_SECRET e CRON_SECRET;
# com EMAIL_PROVIDER=resend também RESEND_API_KEY, EMAIL_FROM, RESEND_WEBHOOK_SECRET e SEND_EMAIL_HOOK_SECRET.
# Base dos links nos e-mails (origem do remoa-frontend). WEB_ORIGIN acima continua valendo; APP_URL prevalece quando os dois existem.
APP_URL=http://localhost:3000
# Origem pública desta API: links de descadastro e .ics, URL do webhook do Resend e do hook do Supabase.
API_ORIGIN=http://localhost:4000
# console = grava o e-mail em .emails/ e no log (padrão em desenvolvimento) · resend = envia de verdade
EMAIL_PROVIDER=console
# Chave de API do Resend (re_...). Obrigatória com EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Remetente. Com resend é obrigatório (sem padrão no código). Ex.: Remoa <contato@remoa.com.br>
EMAIL_FROM=
# Endereço de resposta. Vazio = o endereço de EMAIL_FROM.
EMAIL_REPLY_TO=
# Domínio de envio verificado no Resend (usado por `pnpm emails:check`). Se preenchido, EMAIL_FROM precisa estar nele. Ex.: remoa.com.br
EMAIL_DOMAIN=
# Segredo de assinatura dos webhooks do Resend (whsec_..., Svix). Obrigatório em produção com resend.
RESEND_WEBHOOK_SECRET=
# 32+ caracteres aleatórios; assina os links de descadastro. Substitui UNSUBSCRIBE_SECRET (F13), que ainda é lido quando este está vazio
# para os links já enviados continuarem valendo (D-734). Para migrar sem quebrar links antigos, copie o valor de UNSUBSCRIBE_SECRET para cá.
EMAIL_UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_SECRET=
# Staging: se preenchido, todo e-mail vai para este endereço em vez do destinatário real.
EMAIL_TEST_REDIRECT=
# Segredo do hook "Send Email" do Supabase Auth (v1,whsec_...). Obrigatório em produção com resend.
SEND_EMAIL_HOOK_SECRET=
# Rodapé de todo e-mail (opcional, P-304): razão social e endereço. Vazio = só "Remoa".
EMAIL_FOOTER_LEGAL_NAME=
EMAIL_FOOTER_ADDRESS=
# 32+ caracteres aleatórios; protege as rotas /v1/cron/* (Bearer). Obrigatório em produção.
CRON_SECRET=
# HMAC key for the IP hash in account_events.meta (F13). Unset = the IP is not recorded at all.
AUDIT_HASH_SECRET=
# F17: HMAC key for the shared-link access grant and the token/IP hashes in share_attempts (any long random string).
# Share URLs are `${WEB_ORIGIN}/m/<token>`.
SHARE_SECRET=
# F19: salt of the admin audit IP hash, sha256(ip + salt) (any long random string). Unset = the IP is not recorded.
AUDIT_IP_SALT=

# D-537: who is the client (rate limits, IP hashes). Forwarded headers are trusted only through these; otherwise the socket address.
# Number of proxies in front of the API that append to x-forwarded-for (load balancer, Cloudflare...). 0/unset = API exposed directly.
# Set it to the real count on the host (Q-008): too low trusts a spoofable entry, unset behind a proxy puts every client in one bucket.
TRUSTED_PROXY_HOPS=
# Shared with remoa-frontend: its server sends x-remoa-client-ip + x-remoa-proxy-secret for calls made on behalf of a browser.
# Any long random string, same value in both deploys. Unset = x-remoa-client-ip is ignored.
PROXY_SHARED_SECRET=

# G16 store waitlist (D-654). Status: soon | beta | open (only soon is implemented). Split hown as an illustrative example only.
STORE_STATUS=soon
STORE_SPLIT_SELLER_PCT=85
