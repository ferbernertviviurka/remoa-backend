# Supabase local: `pnpm --silent db:env > .env` preenche estas chaves
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
# Production (D-1090/P-548): use Supabase's *Session* pooler (port 5432, host aws-0-<region>.pooler.supabase.com) or the direct connection.
# The API prepares statements (postgres.js `prepare: true`); the Transaction pooler (port 6543) does not keep them and would break queries.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWT_SECRET=
# Integration tests (vitest) run against a database only if you name it here (P-481); CI sets it. Empty = they skip.
TEST_DATABASE_URL=

# API
PORT=4000
# CORS: origens do web separadas por vírgula (sem caminho, sem curinga). A primeira é a canônica (retorno do Stripe; links se APP_URL faltar).
# Produção: WEB_ORIGIN=https://remoa.com.br,https://www.remoa.com.br
WEB_ORIGIN=http://localhost:3000

# Object storage via S3 API (D-047). Local: `pnpm --silent db:env > .env` fills these from Supabase Storage.
# Production (Cloudflare R2): S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY = R2 API token, S3_BUCKET = private bucket name.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=assets
# virtual: bucket in the subdomain (Railway buckets require it). Empty: path-style (Supabase Storage, R2).
S3_URL_STYLE=

# AI (G22, CLAUDE.md rule 13): every call goes through packages/ai; provider, address, models, fallbacks and limits come only from here.
# Live calls need OPENROUTER_API_KEY + AI_BASE_URL + AI_MODEL. Without them (and without AI=mock), POST /v1/ai/generate-pdf|generate-board
# answer 503 ai_unavailable and the grader/rubric fall back to the rubric-only check. Check with `pnpm ai:doctor`; /health shows `ai.status`.
# Values below are the TEST setup (free text-only model). Production: a paid model, AI_REQUIRE_FREE=0, AI_DATA_COLLECTION=deny.
# Server-only key: never NEXT_PUBLIC_, never logged.
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Fallbacks in order, comma-separated (tried on a removed model, persistent 429 or exhausted 5xx).
AI_MODEL_FALLBACKS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Optional per-function model (falls back to AI_MODEL): AI_MODEL_GRADER, AI_MODEL_RUBRIC, AI_MODEL_EXTRACT, AI_MODEL_VERIFY (F31 content:verify).
AI_MODEL_GRADER=
AI_MODEL_RUBRIC=
AI_MODEL_EXTRACT=
AI_MODEL_VERIFY=
AI_TIMEOUT_MS_VERIFY=
# 1 = refuse any model whose id does not end in :free or whose catalog price is not zero (no spending by accident in tests).
AI_REQUIRE_FREE=1
# With NODE_ENV=production (or unset), a :free model is refused unless this is 1.
AI_ALLOW_FREE_IN_PROD=0
# Sent as provider.data_collection on every request: allow (tests with synthetic text only) | deny (production; default when empty).
AI_DATA_COLLECTION=allow
# 1 = only zero-data-retention endpoints (OpenRouter provider.zdr). Production: 1.
AI_ZDR=0
# Per attempt; retries (exponential backoff + jitter) only on 429, 5xx and timeout.
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Local per-process ceilings (OpenRouter free tier: 20/min, 50/day per account). Warns at 80%. One replica only; more replicas = counter in the DB.
AI_RPM_LIMIT=15
AI_RPD_LIMIT=40
# OpenRouter identification headers (HTTP-Referer, X-Title).
AI_APP_URL=https://remoa.com.br
AI_APP_NAME=Remoa
# OCR for scanned PDFs (Mistral). Needs both; without them text PDFs still work (pdf.js, D-581) and scanned ones fail as pdf_unreadable.
MISTRAL_API_KEY=
AI_OCR_MODEL=mistral-ocr-latest
# Local dev/e2e only (requires NODE_ENV=development or test): AI=mock generates maps offline (deterministic draft from the PDF text, no provider call).
AI=

# Payment
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Founder (one-time, D-375). Unset = R$ 599,90.
STRIPE_PRICE_LIFETIME=
STRIPE_COUPON_FUNDADOR=
# Local dev/e2e only (requires NODE_ENV=development or test; `pnpm dev` sets it): STRIPE=mock replaces Stripe with a fake (D-100).
STRIPE=

# Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Logging
LOG_LEVEL=info

# Local dev/e2e only (requires NODE_ENV=development or test): GRADER=mock injects the contracts mock grader (D-061, until F05 ships).
GRADER=

# --- E-mail, avisos e jobs (G18 · F24/F25/F26) — para ir a produção, troque só estes valores ---
# Lidos e validados por packages/config/src/env.ts (D-732). A API não sobe se faltar algo obrigatório (a mensagem diz o quê, nunca o valor).
# Desenvolvimento (NODE_ENV=development|test, o `pnpm dev`) funciona sem nada disto: EMAIL_PROVIDER=console e padrões locais neutros.
# Produção (NODE_ENV ausente conta como produção) exige: EMAIL_PROVIDER, APP_URL (ou WEB_ORIGIN), API_ORIGIN, EMAIL_UNSUBSCRIBE_SECRET e CRON_SECRET;
# com EMAIL_PROVIDER=resend também RESEND_API_KEY, EMAIL_FROM, RESEND_WEBHOOK_SECRET e SEND_EMAIL_HOOK_SECRET.
# Base dos links nos e-mails (origem do remoa-frontend). WEB_ORIGIN acima continua valendo; APP_URL prevalece quando os dois existem.
APP_URL=http://localhost:3000
# Origem pública desta API: links de descadastro e .ics, URL do webhook do Resend e do hook do Supabase.
API_ORIGIN=http://localhost:4000
# console = grava o e-mail em .emails/ e no log (padrão em desenvolvimento) · resend = envia de verdade
EMAIL_PROVIDER=console
# Chave de API do Resend (re_...). Obrigatória com EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Remetente. Com resend é obrigatório (sem padrão no código). Ex.: Remoa <contato@remoa.com.br>
EMAIL_FROM=
# Endereço de resposta. Vazio = o endereço de EMAIL_FROM.
EMAIL_REPLY_TO=
# Domínio de envio verificado no Resend (usado por `pnpm emails:check`). Se preenchido, EMAIL_FROM precisa estar nele. Ex.: remoa.com.br
EMAIL_DOMAIN=
# Segredo de assinatura dos webhooks do Resend (whsec_..., Svix). Obrigatório em produção com resend.
RESEND_WEBHOOK_SECRET=
# 32+ caracteres aleatórios; assina os links de descadastro. Substitui UNSUBSCRIBE_SECRET (F13), que ainda é lido quando este está vazio
# para os links já enviados continuarem valendo (D-734). Para migrar sem quebrar links antigos, copie o valor de UNSUBSCRIBE_SECRET para cá.
EMAIL_UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_SECRET=
# Staging: se preenchido, todo e-mail vai para este endereço em vez do destinatário real.
EMAIL_TEST_REDIRECT=
# Segredo do hook "Send Email" do Supabase Auth (v1,whsec_...). Obrigatório em produção com resend.
SEND_EMAIL_HOOK_SECRET=
# Rodapé de todo e-mail (opcional, P-304): razão social e endereço. Vazio = só "Remoa".
EMAIL_FOOTER_LEGAL_NAME=
EMAIL_FOOTER_ADDRESS=
# 32+ caracteres aleatórios; protege as rotas /v1/cron/* (Bearer). Obrigatório em produção.
CRON_SECRET=
# HMAC key for the IP hash in account_events.meta (F13). Unset = the IP is not recorded at all.
AUDIT_HASH_SECRET=
# F17: HMAC key for the shared-link access grant and the token/IP hashes in share_attempts (any long random string).
# Share URLs are `${WEB_ORIGIN}/m/<token>`.
SHARE_SECRET=
# F19: salt of the admin audit IP hash, sha256(ip + salt) (any long random string). Unset = the IP is not recorded.
AUDIT_IP_SALT=

# D-537: who is the client (rate limits, IP hashes). Forwarded headers are trusted only through these; otherwise the socket address.
# Number of proxies in front of the API that append to x-forwarded-for (load balancer, Cloudflare...). 0/unset = API exposed directly.
# Set it to the real count on the host (Q-008): too low trusts a spoofable entry, unset behind a proxy puts every client in one bucket.
TRUSTED_PROXY_HOPS=
# Shared with remoa-frontend: its server sends x-remoa-client-ip + x-remoa-proxy-secret for calls made on behalf of a browser.
# Any long random string, same value in both deploys. Unset = x-remoa-client-ip is ignored.
PROXY_SHARED_SECRET=

# G16 store waitlist (D-654). Status: soon | beta | open (only soon is implemented). Split hown as an illustrative example only.
STORE_STATUS=soon
STORE_SPLIT_SELLER_PCT=85

# --- Blog e páginas legais (G19 · F27, D-914) — lidos e validados por packages/config/src/env.ts ---
# Produção exige SITE_URL, BLOG_PREVIEW_SECRET, S3_PUBLIC_BUCKET, R2_PUBLIC_BASE_URL, REVALIDATE_SECRET e LEGAL_*_VERSION.
# Origem pública do site (canonical, sitemap, links de pré-visualização). Ex.: https://remoa.com.br
SITE_URL=http://localhost:3000
# 32+ caracteres aleatórios; assina os links de pré-visualização (24 h).
BLOG_PREVIEW_SECRET=
# Bucket das imagens do blog (chaves blog/...); pode ser o mesmo S3_BUCKET. Local: bucket público "blog" do Supabase Storage (supabase/config.toml).
S3_PUBLIC_BUCKET=blog
# Base das URLs das imagens, sem barra no fim. Bucket privado (Railway): <API>/v1/public/blog/files. Local: Supabase Storage.
R2_PUBLIC_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/blog
# Revalidação sob demanda do web (POST com Bearer). Vazio = ${SITE_URL}/api/revalidate. O segredo é o mesmo REVALIDATE_SECRET do web.
REVALIDATE_URL=
REVALIDATE_SECRET=
# Opcional (Q-067): chave do IndexNow (Bing). Vazio = não avisa.
INDEXNOW_KEY=
# Versões atuais dos Termos e da Política (iguais às do web). Mudou a versão = novo aceite (FR-46).
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=

# F33 rollout: defaults on only in development/test; off in production/unset. Existing F32 remains independent.
QUESTIONS_IMPORT_ENABLED=
QUESTIONS_CATALOG_ENABLED=
QUESTIONS_SESSIONS_ENABLED=
# Abuse guard per API instance, not billing/plan quota; reports are per owner+question/hour, others per owner/minute.
QUESTIONS_RATE_UPLOAD=5
QUESTIONS_RATE_IMPORT=3
QUESTIONS_RATE_SESSION=20
QUESTIONS_RATE_REPORT=5
# Bump when OCR language/configuration/binary changes; preserves versioned private page caches.
QUESTIONS_OCR_CACHE_VERSION=tesseract-por-180-psm3-v1
