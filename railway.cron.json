{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "pnpm --filter @remoa/api exec tsx src/account/maintenance.ts",
    "cronSchedule": "0 * * * *",
    "restartPolicyType": "NEVER"
  }
}
