{
  "name": "@remoa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --include '../../packages/*/src/**/*.ts' --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "job:maintenance": "tsx --env-file=../../.env src/account/maintenance.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.load.test.ts' --exclude '**/node_modules/**'",
    "test:perf": "vitest run src/reports/progress.load.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@hono/node-server": "^2.1.3",
    "@remoa/ai": "workspace:*",
    "@remoa/anki": "workspace:*",
    "@remoa/contracts": "workspace:*",
    "@remoa/db": "workspace:*",
    "@remoa/fsrs": "workspace:*",
    "@remoa/log": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "inngest": "^4.21.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "dotenv": "^17.0.0",
    "tsx": "^4.23.15"
  }
}
